{
  // The History page is plain JavaScript that the webview loads as is, with no build step: this
  // config type-checks it as browser code, with no Node types, and the editor applies it too.
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "allowJs": true,
    "checkJs": true,
    "noEmit": true,
    "strict": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "noImplicitReturns": true,
    "noFallthroughCasesInSwitch": true,
    "types": []
  },
  "include": ["*.js", "*.d.ts"]
}
